rules_version = '2';

// !! NOT DEPLOYED -- see docs/blaze-upgrade.md.
// Google's late-2024 policy change requires Blaze to enable Firebase
// Storage on newly-created projects. rc-beesty is one of those, so
// the bucket can't be set up yet. `firebase deploy --only storage`
// fails with "Firebase Storage has not been set up on project". The
// client falls back gracefully: SidePanel surfaces a yellow
// "DEM loaded for this session but cloud save failed" warning and
// the GeoTIFF still works for the session, just doesn't persist.
//
// These rules are ready to deploy as soon as the Blaze upgrade
// happens and Storage gets enabled in the Console.
//
// BESSTY (rc-beesty) Firebase Storage rules.
//
// Currently only used for per-project DEM uploads at
// `projects/{projectId}/dem/{filename}`. Access mirrors the Firestore
// project's read/write semantics: anyone who can see the project doc
// can read the DEM; anyone who can edit the project doc can upload /
// replace it; only owners + admins can effectively delete (by
// deleting the project, or by uploading a replacement which we then
// clean up client-side).
//
// Hard 200 MB cap per upload, enforced server-side as a second line
// of defence beyond the client-side check in firestoreStorage.ts.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
            .data.flags.admin == true;
    }

    function project(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data;
    }

    function canReadProject(projectId) {
      let p = project(projectId);
      return signedIn() && (
        p.visibility == 'public' ||
        request.auth.uid == p.ownerUid ||
        (p.allowedUserIds is list && request.auth.uid in p.allowedUserIds) ||
        isAdmin()
      );
    }

    function canEditProject(projectId) {
      let p = project(projectId);
      return signedIn() && (
        request.auth.uid == p.ownerUid ||
        (p.allowedUserIds is list && request.auth.uid in p.allowedUserIds) ||
        isAdmin()
      );
    }

    // ===== Project DEMs =====
    match /projects/{projectId}/dem/{filename} {
      allow read: if canReadProject(projectId);

      // Upload: writer-level access AND under the 200 MB cap.
      allow write: if canEditProject(projectId)
        && request.resource.size < 200 * 1024 * 1024;

      // Delete: writer-level (covers the "replace DEM" flow that
      // deletes the old object after the new one uploads).
      allow delete: if canEditProject(projectId);
    }

    // ===== Share payloads =====
    //
    // Where a share's payload lands when it is too big for a Firestore
    // document (a multi-state share with full rasters runs to megabytes).
    // The object name is the share token, so reaching this object requires
    // the same ~190-bit capability as reading the share doc itself.
    //
    // Read is PUBLIC and unconditional, which is a deliberate and narrow
    // trade. Storage rules cannot read a Firestore document cheaply enough to
    // re-check `revoked` and `expiresAt` on every object read, so revocation
    // is enforced by DELETING the object — the revoke path removes it, and
    // republishing writes a new token. That means the only window where a
    // revoked share's payload is still fetchable is between the flag flip and
    // the delete, and the flag flip alone already stops the viewer resolving
    // the token to this path.
    //
    // Writes are the function's (admin SDK bypasses these rules). No client
    // may write here, and — as in Firestore — LIST IS NEVER GRANTED, so the
    // bucket cannot be walked for tokens.
    match /shares/{token}/{objectName} {
      allow get: if true;
      allow list: if false;
      allow write, delete: if false;
    }

    // ===== Default: deny =====
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
