# Repo-root-anchored (leading slash): an unanchored `Standards/` also matches
# the `crates/iso9613-core/src/standards/` source module (case-insensitively on
# Windows) and silently drops it from version control.
/Standards/

# Build artefacts — the workspace target plus any per-crate target dirs
# (workspace-excluded crates like iso9613-py build to their own target/).
solver/target/
**/target/
web/node_modules/
web/dist/
web/.vite/
web/tsconfig.tsbuildinfo

# Firebase Cloud Functions build output + deps
functions/node_modules/
functions/lib/
functions/.firebase/
.firebase/
firebase-debug.log

# Environment files (per-checkout, never committed)
.env
.env.local
*.local

# OS / editor cruft
.DS_Store
Thumbs.db
*~
~$*

# Pre-migration wasm snapshot used by validation/run_validation.mjs — a build
